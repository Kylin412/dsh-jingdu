{
  "name": "dsh-jingdu",
  "version": "1.0.1",
  "license": "MIT",
  "type": "module",
  "description": "鲸读（Jingdu）：用 DeepSeek TTS 朗读 DSH 助手回复 — 流式播放、总结、soul.md 人设、自动播报与设置面板。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "tts",
    "text-to-speech",
    "voice",
    "jingdu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kylin412/dsh-jingdu.git"
  },
  "homepage": "https://github.com/Kylin412/dsh-jingdu#readme",
  "bugs": {
    "url": "https://github.com/Kylin412/dsh-jingdu/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-0 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "soul.md",
    "README.md",
    "CHANGELOG.md",
    "TEST-REPORT.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
